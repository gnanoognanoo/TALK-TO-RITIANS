# ==============================================================================
# TALK TO RITIANS - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# DO NOT commit .env or .env.local to Git!
# ==============================================================================

# Supabase Project API URL (Found in Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Safe for browser client usage with RLS enabled)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Optional: Application Environment ('development' | 'staging' | 'production')
VITE_APP_ENV=development
